# Normalize line endings for cross-platform deploys.
# Default: auto-detect text, store LF in the repo.
* text=auto eol=lf

# Shell scripts + Linux config files MUST be LF (CRLF makes bash fail with "bad interpreter").
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
.dockerignore text eol=lf
javis.service text eol=lf

# Windows scripts keep CRLF.
*.bat       text eol=crlf
*.vbs       text eol=crlf
*.ps1       text eol=crlf

# Binary - leave alone.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp3 binary
*.db binary
