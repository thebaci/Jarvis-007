# Keep build context small + never bake secrets/state into the image.
# NOTE: do NOT exclude .claude/skills and system/ - they are the SYSTEM LAYER (default skills/loops)
# and must be in the image so they update with the version.
.git
.venv
.claude/worktrees/
.claude/settings.local.json
**/.claude/skills/.disabled/
**/__pycache__
*.pyc
*.pyo
.env
.env.*
# env.example (no leading dot) does not match the pattern above so it still goes into the image - no negation needed
# Heavy dev artifacts (all gitignored, but the Dockerfile uses `COPY . .` so .dockerignore
# is the ONLY barrier - anything missing here goes straight into the build context).
# TRAP: .dockerignore matches patterns from the context ROOT, it does NOT match at every depth like .gitignore does.
# A bare `.staging/` only excludes <root>/.staging, NOT server/.staging (114MB) - all along.
# To match at every depth you must write `**/`, exactly like the `**/__pycache__` line above.
.learn/
.gitnexus/
.superpowers/
.pytest_cache/
videos/
**/.staging
# Tests do not run in the image. Since 0.9.242 they live neatly in tests/ so one line excludes them;
# before that they were scattered across server/ and dashboard/ so there was no way to exclude them without touching the source.
tests/

# Brain data
Brain Default/
brain/
brains/
**/brains-backup
**/brain-trash
vault/

# STATE + SECRETS in server/. This list must follow the "Runtime / temp" section of
# .gitignore. Before 0.9.241 it was an old, much weaker copy: it lacked .secret_key, .hub_token,
# .oauth_mcp.json, plugins/, connector-home/, the .db files... so anyone running `docker build`
# locally baked their own secret keys into the image. The GHCR build runs from a clean checkout
# so it was not affected, which is why this bug lived so long unnoticed.
server/settings.json
server/.sessions.json
server/.secret_key
server/.hub_token
server/.oauth_mcp.json
server/.mcp_config.json
server/.mcp_hub_*.json
server/mcp_servers.json
server/mcp_servers.v1.bak.json
server/mcp_audit.jsonl*
server/loop_config.json
server/learn_config.json
server/metrics_cache.json
server/plugins.json
server/plugins/
server/plugin-data/
# Folders HOLDING CREDENTIALS generated by connections at run time. connector-cred is the token store that some
# connectors keep themselves (workspace-mcp); purge-trash temporarily keeps those same folders for 30 days after the
# user deletes a connection, so a mistaken click can be undone. Both must NEVER go into the repo.
server/connector-home/
server/connector-files/
server/connector-cred/
server/purge-trash/
# Tools Javis installs silently at run time (the pinned version of the javis-zalo Zalo CLI, run directly with Node). Generated at run time, with a heavy node_modules.
server/tools/
# Choices to REMOVE default capabilities (core connectors...). User data, different on every machine.
server/core-off.json
# Extension packs the user installs (connectors/plugins dropped in at run time). User data.
server/packs/
server/packs.json*
server/packs-state/
server/packs-staging/
server/packs-store-cache.json
# Run artifacts of the 0.5x versions: conversation state, memory index, and the Antigravity prompt
# written out for debugging. Generated at run time so they belong neither in the repo nor in the image.
server/conversation_state.db*
server/memory_index.db*
server/antigravity-duong-prompt.json
server/usage-marks.jsonl*
server/usage.json
server/usage-events.jsonl*
server/usage_index.db*
server/session_brain.db*
server/kanban.sqlite3*
server/conversations.db
server/conversations.db-wal
server/conversations.db-shm
server/tg_brain.json
server/update_state.json
server/logs/
server/brain-trash/
server/tmp/
server/_selfupdate.bat
server/javis.log
*.log
*.mp3
.DS_Store
Thumbs.db
desktop.ini
