# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Environment (local configuration; env.example is the template)
.env

# Runtime / temp
.staging/
server/*.pid
*.mp3
# Preview samples of the 9 ChatGPT Live voices that ship with the app (0.65.17), not temp files.
!dashboard/voices/*.mp3
test_output*.mp3
server/*.log
server/loop_config.json
server/learn_config.json
server/usage.json
server/usage-events.jsonl*
server/usage_index.db*
server/session_brain.db*
server/metrics_cache.json
server/settings.json
server/plugins.json
server/plugins/
server/plugin-data/
server/.sessions.json
server/mcp_servers.json
server/mcp_servers.v1.bak.json
server/.mcp_config.json
server/.mcp_hub_*.json
server/.secret_key
server/.hub_token
# Leftover from an old version (before 0.64.47, the feature was removed; the server deletes this file itself at boot).
# Keep the ignore line so a file left behind on an old machine does not slip into `git add -A`.
server/.setup_token
# CLI API tokens: the file holds the HASH + the token name, still an operational secret, does not go into the repo.
server/.api_tokens.json
server/auth_audit.jsonl*
server/.oauth_mcp.json
server/mcp_audit.jsonl*
# Folders HOLDING CREDENTIALS generated by connections at run time. connector-cred is the token store that some
# connectors keep themselves (workspace-mcp); purge-trash temporarily keeps those same folders for 30 days after the
# user deletes a connection, so a mistaken click can be undone. Both must NEVER go into the repo.
server/connector-home/
server/connector-files/
server/connector-cred/
server/purge-trash/
# Tools Javis installs silently at run time (the pinned version of the javis-zalo Zalo CLI, run directly with Node). Generated at run time, with a heavy node_modules.
server/tools/
# Choices to REMOVE default capabilities (core connectors...). User data, different on every machine.
server/core-off.json
# Extension packs the user installs (connectors/plugins dropped in at run time). User data.
server/packs/
server/packs.json*
server/packs-state/
server/packs-staging/
server/packs-store-cache.json
# Run artifacts of the 0.5x versions: conversation state, memory index, and the Antigravity prompt
# written out for debugging. Generated at run time so they belong neither in the repo nor in the image.
server/conversation_state.db*
server/memory_index.db*
# Cached path of the CLI binary (claude_cli.tim_binary). Run state that is per MACHINE:
# STATE_DIR defaults to the server/ folder itself, so if it is not hidden every app run
# dirties the git tree with one more file, and `git add -A` commits another person's machine paths.
server/bin_paths.json
server/claude-update.json
server/agy-update.json
server/antigravity-duong-prompt.json
server/usage-marks.jsonl*
server/conversations.db
server/conversations.db.bak-*
# Snapshot taken when upgrading team chat groups (0.140.0) and the copy kept on restore: it holds all of the user's chats.
server/conversations.db.pre-*
server/conversations.db.post-*
# PID ledger of MCP stdio processes (cleaning up orphan processes, 0.114.0): run data, written to the default state folder server/.
server/mcp-stdio-pids.json
server/md_hong_da_soi.json
server/conversations.db-wal
server/conversations.db-shm
# Customer conversation store (Bot inbox). User data, never goes to git.
server/customer_conversations.sqlite3*
server/runtime.db
server/runtime.db-wal
server/runtime.db-shm
server/capability_registry.db
server/capability_registry.db-wal
server/capability_registry.db-shm
server/capability_registry.db*.corrupt-*
# Added in 0.9.241: the 6 artifacts below were neither tracked nor ignored, so a single
# `git add -A` would commit run data + deploy state straight into the repo.
server/kanban.sqlite3*
# workflow_runs.sqlite3: the workflow run history store (Task 2 Assistants), same class as
# kanban.sqlite3* above - a test that does not set JAVIS_STATE_DIR will write into server/ because
# execute_workflow now always touches workflow_runs.get_store().
server/workflow_runs.sqlite3*
# The Resonance store (goals, agent identity ledger) and the team chat group store: run data, same class as kanban.sqlite3*.
# A server run from a worktree without JAVIS_STATE_DIR set will write into server/.
server/resonance.sqlite3*
server/team.sqlite3*
server/tg_brain.json
server/update_state.json
server/logs/
server/brain-trash/
server/tmp/
server/_selfupdate.bat
# Added in 0.12.4: the Telegram bot store of the Chatbot page (0.19.0) and the conversation log of
# those bots. Both are run data in STATE_DIR (chatbot_store.py, chatbot_log.py) and
# chatbots.json also holds bot tokens.
server/chatbots.json
# Inbox + Web Push: real run state (STATE_DIR defaults to server/ itself when
# JAVIS_STATE_DIR is not set). vapid.json holds the PRIVATE KEY - if it leaks into the repo anyone can push
# fake notifications to registered browsers.
server/inbox.json
server/vapid.json
server/push_subs.json
server/chatbot-logs/
# Videos made with HyperFrames (very heavy, not part of the source)
videos/

# Default in-repo vault (personal data, not versioned)
vault/

# Personal memory of the project brain (changes every session, no need to version)
brain/Memory/

# Dev artifact - outside repos cloned for reference (very heavy, with their own .git)
.learn/

# Cache/artifacts of dev tools. These folders must be ignored in every clone.
# .git/info/exclude on one person's machine - and that file is NOT committed. It means anyone
# making a fresh clone or fork of the project sees them show up as untracked, and the 106MB GitNexus index
# could get committed. test_ignore_files.py catches exactly this when run on CI.
.gitnexus/
.superpowers/
.claude/worktrees/
.codex-tmp/

# Local dev preview launch configuration (machine-specific paths, not part of the product)
.claude/launch.json

# PARENT folder holding EVERY second brain (the new model) - PERSONAL DATA, not pushed into the code repo.
# Back it up separately to another git repo (see the bind-mount comment in docker-compose.yml).
brains/
# Brain backups the server creates itself (PERSONAL DATA) - never version them.
brains-backup/

# PERSONAL data in the OLD default brain (not versioned): memory, business-metrics cache,
# automations (containing chat_id). The folder structure + sample agents/workflows are still versioned.
Brain Default/Memory/
Brain Default/05 - Data Cache/
Brain Default/Attachments/
Brain Default/Javis/automations.json

# The sample Brain Default after being moved into brain/ - commit only the structure + sample agents/workflows,
# do NOT commit personal data (memory, business-metrics cache, attachments, automations containing chat_id).
brain/Brain Default/Memory/
brain/Brain Default/05 - Data Cache/
brain/Brain Default/Attachments/
brain/Brain Default/Javis/automations.json

# Disabled skills (moved into .disabled when turned off) - local state, not versioned
**/.claude/skills/.disabled/

# Junk files / personal scripts at the root (not part of the public product)
# Removed the two lines /agents and /workflows in 0.9.241: they were created to hide two 28-byte junk files
# (log fragments "- Move: Jarvis\agents -" from a broken redirect command), but the side effect was permanently blocking
# the creation of REAL agents/ or workflows/ folders at the root. The two junk files have been deleted outright.
parse_ads*.ps1

# OS
.DS_Store
Thumbs.db
desktop.ini
server/stop-last.log

# Playwright MCP writes snapshots/console output into the cwd when checking the dashboard
.playwright-mcp/
server/.mcp_agy_*.json
server/settings.json.bak*
# Context files Antigravity CLI generates on every run (junk of the running machine, not code)
server/.javis-agy/
# The group conversation arbiter (0.65.0): the decision store + learned cases hold CUSTOMERS' CHAT TEXT, never goes to git.
server/chatbot_reply_policy.sqlite3*
server/reply_policy_cwd/
# Bot channel accounts (encrypted tokens) are run data, not source code.
server/channel_accounts.json

# The listening benchmark (tools/stt_bench): audio clips and results, not pushed to git
server/stt_bench/
